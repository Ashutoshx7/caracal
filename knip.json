{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tests/typescript/**/*.ts",
        "tests/shared/**/*.ts",
        "scripts/*.mjs",
        "scripts/lib/*.mjs"
      ],
      "paths": {
        "@/*": [
          "apps/web/src/*"
        ]
      }
    },
    "apps/auth": {
      "entry": [
        "src/migrate.ts"
      ]
    },
    "docs": {
      "entry": [
        "src/components/**/*.astro",
        "src/middleware/**/*.mjs",
        "versioning.mjs"
      ]
    }
  },
  "ignoreFiles": [
    "packages/engine/scripts/render-dev-env.mjs"
  ],
  "ignoreBinaries": [
    "build",
    "sync-embedded",
    "go",
    "icacls"
  ],
  "ignoreDependencies": [
    "tsx",
    "react",
    "react-dom",
    "pg",
    "@tanstack/react-query"
  ]
}
