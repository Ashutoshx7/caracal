# Caracal, a product of Garudex Labs
#
# Example variable values for the Azure VM environment. Copy to terraform.tfvars and edit.

subscriptionId    = "00000000-0000-0000-0000-000000000000"
resourceGroupName = "caracal-vm"
region            = "centralindia"
name              = "caracal"

caracalVersion = "v1.0.0-rc.2"
machineSize    = "Standard_D4as_v5"
diskGb         = 128

# Placement and storage. Leave zone empty to let the platform choose; setting it
# pins the host and its disk to one zone, so recovery means recreating there.
# zone     = "1"
# diskType = "StandardSSD_LRS"

# Networking. Empty subnetId creates a dedicated network, which suits a first
# deployment. Supply an existing subnet to place the host inside a network that
# already has peering, private endpoints, or egress control.
subnetId = ""
# networkCidr = "10.60.0.0/16"

# Base image. Empty uses the published Ubuntu LTS image the bootstrap targets;
# set it to pin a hardened or golden image from a shared image gallery.
# sourceImageId = ""

# Requires the subscription-level feature to be registered before use.
# encryptionAtHost = true

adminPublicKey = "ssh-ed25519 AAAA... you@example.com"

# Restrict SSH to your own address. Leave empty to admit none and use the serial
# console instead.
adminCidrs = ["203.0.113.4/32"]

# Each hostname must resolve to the publicIp output before the certificate can be
# issued. The console origin and the STS issuer are derived from these routes, so
# they cannot disagree with what the proxy terminates.
#
# These nest under a product subdomain because example.com stands for a company's
# own domain. Where the domain is the product itself, use flat names such as
# console.caracal.run. The STS origin becomes the issuer claim in every mandate
# and is configured in every external verifier: choose it once and keep it.
tlsProxy = {
  email = "ops@example.com"
  routes = {
    "console.caracal.example.com" = "web"
    "sts.caracal.example.com"     = "sts"
    "gateway.caracal.example.com" = "gateway"
  }
}

# DNS lives with another provider in this example, so no zone is given and the
# records are created there against the publicIp output.
dnsZone = ""

tags = {
  environment = "test"
  managedBy   = "opentofu"
}
